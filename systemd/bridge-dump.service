[Unit]
Description=Дамп баз продукта (realty, news, vectors, graph) и ротация наборов
# Нужен и докер (дамп снимается `pg_dump` из контейнеров), и запущенные базы.
After=network-online.target docker.service

[Service]
#: Воркспейс — НАСТРОЙКОЙ, а не от расположения файла: `infra/` выносится в отдельный репозиторий,
#: и путь от скрипта перестанет указывать на воркспейс (см. `infra/lib/workspace.sh`).
Environment=AGENT_WORKSPACE=__WORKSPACE__
#: Каталог наборов дампов: `db/db-dump.sh` требует его и без него отказывается работать. Задаётся здесь,
#: а не в `.env`: скрипт не читает `.env`, и переменная должна прийти в его окружение от юнита.
Environment=DB_DUMP_DIR=__DB_DUMPS__
Type=oneshot
# Расписание, а не сторож: результат дампа — набор файлов и манифест, ошибка видна ненулевым кодом
# (`systemctl --user --failed`) и громким текстом. Учение восстановления НЕ здесь: оно тяжёлое и
# запускается руками (`make restore-drill`), иначе «проверка» станет ещё одним регулярным шумом, который
# перестают читать.
ExecStart=/bin/bash __WORKSPACE__/infra/db/db-dump.sh
