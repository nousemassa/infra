[Unit]
Description=Обрезка лога MCP-листенера (потолок размера файла)
After=bridge-mcp.service

[Service]
#: Воркспейс — НАСТРОЙКОЙ, а не от расположения файла: `infra/` выносится в отдельный репозиторий,
#: и путь от скрипта перестанет указывать на воркспейс (см. `infra/lib/workspace.sh`).
Environment=AGENT_WORKSPACE=__WORKSPACE__
WorkingDirectory=__WORKSPACE__
Type=oneshot
# Тот же скрипт, что у моста и новостей, но со своими --log/--unit.
ExecStart=/bin/bash __WORKSPACE__/infra/logs/bridge-log-trim.sh --log realty/logs/mcp.log --unit bridge-mcp
