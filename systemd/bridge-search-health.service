[Unit]
Description=Сторож проекта поиска: движок и MCP-обёртка → алерт, лечение контейнеров
# Юнита у службы НЕТ (поиск — контейнерный проект, `search/compose.search.yaml`), поэтому
# зависимость — сам docker: на загрузке контейнеры поднимает демон, и сторож не должен бежать
# раньше него (в user-юните `After=docker.service` декоративен, как и у соседей-сторожей).
After=docker.service

[Service]
#: Воркспейс — НАСТРОЙКОЙ, а не от расположения файла: `infra/` выносится в отдельный репозиторий,
#: и путь от скрипта перестанет указывать на воркспейс (см. `infra/lib/workspace.sh`).
Environment=AGENT_WORKSPACE=__WORKSPACE__
Type=oneshot
# Отдельный сторож, а не строка в `infra/health/health.sh`: выходной код того — ГЕЙТ ВЫКАТА моста, и поломка
# поиска не должна блокировать выкат бота записей.
ExecStart=/bin/bash __WORKSPACE__/infra/health/health-search.sh
