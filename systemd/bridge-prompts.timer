[Unit]
Description=Раз в сутки сверять тексты агентов: файл в репозитории = выкаченная ревизия

[Timer]
# 05:20, а не 05:00: в круглый час расписаний на хосте хватает и без нас (ср. дамп в 04:20).
OnCalendar=*-*-* 05:20
# Хост мог быть выключен ночью — сверку надо сделать сразу после запуска, а не пропускать сутки.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
