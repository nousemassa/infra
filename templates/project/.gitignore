#: Локальное окружение проекта: в git только образец (`.env.example`).
.env

#: Файлы-сессии Telegram (если проект заведёт свой бот) — ключ доступа, в git не попадают никогда.
#: Корневой `.gitignore` рядом остаётся только пока воркспейс цел, а у отдельного репозитория
#: правила обязаны быть свои.
.sessions/
*.session
*.session-journal

#: Логи — ФАЙЛАМИ, а не каталогом: в `logs/` может лежать код (так у обвязки — скрипт обрезки).
logs/*.log
*.log
*.pid

#: Артефакты сборки и кэши инструментов.
wheels/
*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
