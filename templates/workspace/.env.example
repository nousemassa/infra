#: Общая основа воркспейса — файл `$WORKSPACE/.env` (НЕ `infra/.env`): обвязка читает его оттуда, и без
#: него не работает ни один сторож, дамп или проверка (`lib/workspace.sh`). Секретов в git нет: это
#: шаблон, настоящий файл лежит вне репозитория.
#:
#: ❗ Читается как ТЕКСТ (`sed`/`read_text`), а не через `source`: `export` в строках и подстановки
#:    `$ДРУГАЯ_ПЕРЕМЕННАЯ` не развернутся. Значения — литералами.
#:
#: ❗ Сюда НЕ кладутся:
#:    · установочные переменные — их задаёт `systemd/install.sh` и юниты получают через `Environment=`:
#:      `AGENT_WORKSPACE`, `MODELS_SRC`, `DB_DUMP_DIR`, `REBOOT_SNAPSHOT`;
#:    · переопределения для ручного запуска и проб: `VENDOR`, `VENDOR_DIR`, `VENDORS_FILE`,
#:      `BRIDGE_CONTAINER`, `SOLVER_CONTAINER`, `ALERT_NO_MARKER`, `TMPDIR`, `PYTHON`, `PYTHONPATH`;
#:    · ключи продуктов: `DB_URL` и `GRAPH_DB_PASSWORD` (свой `.env` у продукта), `NEWS_*`/`TEAM_*`
#:      (новости), `LLAMA_*`/`SOLVER_URL` (модели), `SEARXNG_*` (поиск);
#:    · переменные стека вендора (`AGENTA_*`, `*_IMAGE_TAG`) — его файлы в репозиторий не входят.

# --- Общая сеть платформы ---
#: Имя сети, в которой живут службы: её создаёт стек платформы, продукты подключаются к ней как к внешней
#: (`external: true`). Значение принадлежит развёртыванию: у каждого стека вендора своё имя.
PLATFORM_NETWORK=

# --- Ось платформы: КТО исполняет ход и ЧЬЮ форму имеет спан ---
#: Значение — имя вендора из `vendors.tsv`. Пусто ⇒ вендор по умолчанию (первый со способностью `runtime`).
PLATFORM_VENDOR=agenta
#: Ось наблюдаемости отдельно от оси рантайма; пусто ⇒ берётся `PLATFORM_VENDOR`.
TELEMETRY_VENDOR=
#: Адрес приёма OTLP того вендора, что принимает трассы (проба живости ходит сюда).
TELEMETRY_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# --- Доставка алертов ---
#: Ключ бизнес-ручки моста (`POST /api/ops/alert`): первый путь доставки. Пусто ⇒ алерт не доставлен,
#: в журнал и маркер уходит названная причина.
BRIDGE_API_KEY=

# --- Признаки, по которым сторожа решают «наблюдать нечего» ---
#: Токен бота новостей: без него сторож новостей в мягком режиме и говорит об этом.
TELEGRAM_NEWS_BOT_TOKEN=
#: Адресаты и тестовый канал: по ним ревизия таблиц отличает нашу тестовую учётку от чужой.
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_MANAGER_CHAT_ID=
TELEGRAM_NEWS_TEST_CHANNEL_ID=

# --- Адреса баз, которые принадлежат ОБЩЕЙ основе ---
#: Векторная база RAG и чекпойнт-база графа. Пароль — внутри адреса; своего `.env` у этих баз нет.
VECTOR_DB_URL=postgresql+asyncpg://USER:CHANGE_ME@pgvector:5432/vectors
REMINDERS_CHECKPOINT_DSN=postgresql+asyncpg://USER:CHANGE_ME@reminders-db:5432/reminders

# --- Платформа: адрес API, ключ, проект ---
#: Адрес HTTP API платформы. Внутри docker-сети — имя службы; для хостовых процессов есть `_HOST`.
PLATFORM_API_URL=http://api:8000/api
PLATFORM_API_URL_HOST=http://127.0.0.1:8680/api
#: Ключ платформы с правами на объекты и приём трасс (`EDIT_SPANS`). Задаётся ЯВНО.
PLATFORM_API_KEY=
PLATFORM_PROJECT_ID=

# --- Ось рантайма: где исполняются роли ---
#: `platform` — через API платформы; `own` — свой рантайм; пусто ⇒ `platform`.
AGENT_RUNTIME=

# --- Telegram: доступ, прокси, адресаты ---
#: Пара с my.telegram.org обязательна для MTProto.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
#: Прокси — одиночный или массив (ссылки t.me/proxy или тройки сервер:порт:секрет).
TELEGRAM_MT_PROXY_SERVER=
TELEGRAM_MT_PROXY_PORT=
TELEGRAM_MT_PROXY_SECRET=
TELEGRAM_MT_PROXIES=
TELEGRAM_OWNER_CHAT_ID=

# --- Ключи нашего HTTP API и кнопок ---
#: `BRIDGE_API_KEY` — ключ бизнес-ручек (`X-API-Key`), `UI_SECRET` — подпись кнопок (≥16 символов).
BRIDGE_API_KEY=
UI_SECRET=
#: Бюджет и таймзона бизнес-логики.
BRIDGE_BUDGET_MONTH_USD=25
BRIDGE_TZ=Europe/Moscow

# --- Провайдер LLM (для ролей своего рантайма и отчётов) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_CHAT=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=
PROXYAPI_API_KEY=
PROXYAPI_BASE_URL=

# --- Приём спанов платформы ---
#: Адрес OTLP платформы и ключ с правом `EDIT_SPANS` (пусто ⇒ `PLATFORM_API_KEY`).
OTEL_ENDPOINT=http://api:8000/api/otlp/v1/traces
OTEL_API_KEY=

# --- Общие пароли и флаги поведения ---
#: Пароль векторной базы: у базы ДВА потребителя (её пишет продукт-владелец, читают оба контура),
#: поэтому ключ живёт в основе, а не в `.env` продукта.
VECTOR_DB_PASSWORD=
#: Флаг напоминаний о визите: его читает продукт, но значение — общая настройка развёртывания.
VISIT_REMINDER_ENABLED=False
#: Цены токенов для отчётов (0 ⇒ «цена неизвестна», а не «бесплатно»).
DIALOG_PRICE_IN_PER_1K_USD=0
DIALOG_PRICE_OUT_PER_1K_USD=0
LISTING_PRICE_IN_PER_1K_USD=0
LISTING_PRICE_OUT_PER_1K_USD=0
#: Тестовый канал новостей: приватный канал для первой публикации (пусто ⇒ только рабочий).
TELEGRAM_NEWS_TEST_CHANNEL_ID=
#: Канал новостей (рабочий): -100… Значение нужно и боту, и сторожу.
TELEGRAM_NEWS_CHANNEL_ID=
